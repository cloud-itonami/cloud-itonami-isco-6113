;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a nursery scheduling/logistics coordination robot
;; performs crew scheduling, record logging and plants/seeds/agrochemical
;; supply-order coordination for nursery growers (ISCO 6113). It never
;; performs cultivation work. Its physical work is supply logistics: moving
;; delivered potting-media pallets down the greenhouse aisle to the potting
;; bench, and racking delivered seed trays in the supply store.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-6113"
 :cases
 [{:id :potting-media-pallet-down-aisle
   :kind :transport
   :procedure "logistics robot moves a delivered pallet of potting media 60 m down the greenhouse aisle to the potting bench"
   :params {:mass-kg 150.0 :distance-m 60.0 :v-max-mps 0.8 :a-max-mps2 0.3
            :brake-decel-mps2 0.5 :drive-force-n 300.0 :crr 0.02
            :cog-height-m 0.45 :support-half-length-m 0.45}
   :sweep {:param :payload-kg :values [50.0 100.0 200.0 350.0 500.0]}
   :quantity :cycle-time-s
   :limit {:max 120.0 :basis "estimate: a pallet move must fit inside the 2-minute aisle-closure window agreed with the crew"}
   :boundary {:lo 10.0 :hi 1500.0}}
  {:id :seed-tray-to-store-rack
   :kind :manipulator
   :procedure "arm racks a delivered carton of seed trays from the cart onto a supply-store rack"
   :params {:l1-m 0.40 :l2-m 0.35 :m1-kg 3.0 :m2-kg 2.0
            :from [0.50 0.05] :to [0.15 0.60] :duration-s 2.0 :steps 400}
   :sweep {:param :payload-kg :values [0.5 1.0 2.0 3.0 5.0]}
   :quantity :peak-tau1-nm
   :limit {:max 35.0 :basis "estimate: continuous shoulder torque of a light (~3-5 kg payload class) collaborative arm"}
   :boundary {:lo 0.1 :hi 15.0}}]}
